# Preview overlay — preview.einktodo.com, debug on, 60 s OTA soak channel.
CONFIG_EINKTODO_API_URL="https://preview.einktodo.com"
CONFIG_EINKTODO_OTA_URL="https://preview.einktodo.com/api/update/rtos/firmware"
CONFIG_EINKTODO_ENABLE_OTA=y
CONFIG_EINKTODO_DEBUG=y
CONFIG_EINKTODO_DEBUG_OTA=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
