+/* EINKTODO PATCH (R4/R5): expose the esp_tls_cfg_t.crt_bundle_attach hook through
+ * the transport layer. The field already exists in esp_tls.h and is honored by
+ * esp_tls_mbedtls.c (guarded by CONFIG_MBEDTLS_CERTIFICATE_BUNDLE), but stock
+ * esp_transport_ssl.* had no setter for it. This one hook carries both the
+ * curated CA bundle (esp_crt_bundle_attach) and the leaf-fingerprint pinning
+ * (pinned_tls_attach) — see upstream.diff. */
+void esp_transport_ssl_crt_bundle_attach(esp_transport_handle_t t,
+                                         esp_err_t ((*crt_bundle_attach)(void *conf)))
+{
+    transport_ssl_t *ssl = esp_transport_get_context_data(t);
+    if (t && ssl) {
+        ssl->cfg.crt_bundle_attach = crt_bundle_attach;
+    }
+}
